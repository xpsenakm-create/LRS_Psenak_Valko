digraph G {
  rankdir=TB; bgcolor=white; pad=0.25; nodesep=0.4; ranksep=0.6;
  node [shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, fontname="DejaVu Sans", fontsize=12, margin="0.14,0.07"];
  edge [color="#52514e", penwidth=1.2, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#3f3f3f"];
  subgraph cluster_pl { label="map_planner_node (A1.1)\nMultiThreadedExecutor, 2 skupiny"; fontname="DejaVu Sans"; fontsize=12; style=rounded; color="#2a78d6";
    plan [label="skupina „planning“\nplan_request → A*"]; query [label="skupina „query“\noccupancy_query"]; }
  subgraph cluster_ex { label="mission_executor_node (A1.2)\nMultiThreadedExecutor, 2 skupiny, 1 mutex"; fontname="DejaVu Sans"; fontsize=12; style=rounded; color="#2a78d6";
    subs [label="skupina „state“\nsubscriptions (uložia správu)"]; tick [label="skupina „timer“\ntick() 20 Hz: kontroly →\nstavový automat → setpoint"]; subs -> tick [style=dotted]; }
  subgraph cluster_out { label="outdoor_mission_node (A1.3)\n1 vlákno (rclcpp::spin), bez mutexu"; fontname="DejaVu Sans"; fontsize=12; style=rounded; color="#2a78d6";
    osub [label="subscriptions\n(stav, poloha, GPS, kompas)"]; otick [label="tick() 30 Hz:\nkontroly → stav → setpoint"]; osub -> otick [style=dotted]; abort [label="služba ~/abort", shape=ellipse]; abort -> otick [style=dotted]; }
  mavros [label="MAVROS", shape=box3d, fillcolor="#f4f4f2", color="#888888"];
  sitl [label="ArduCopter SITL\n(GUIDED)", shape=box3d, fillcolor="#f4f4f2", color="#888888"];
  gz [label="Gazebo\n(hangár / outdoor svet)", shape=box3d, fillcolor="#f4f4f2", color="#888888"];
  rviz [label="RViz", shape=box3d, fillcolor="#f4f4f2", color="#888888"];
  tick -> plan [label="/plan_request"]; plan -> subs [label="/planned_path,\n/planning_status"];
  plan -> rviz [style=dashed, label="map_cloud, inflated_occupancy,\nmarkery"];
  mavros -> subs [label="state, local_position,\nglobal_position, statustext"];
  tick -> mavros [label="/mavros/setpoint_position/local\nslužby set_mode, arming,\ntakeoff, land"];
  mavros -> osub [label="state, pose, velocity, global,\ncompass_hdg, rel_alt"];
  otick -> mavros [label="/mavros/setpoint_raw/local\n(poloha + rýchlosť + yaw)"];
  mavros -> sitl [dir=both, label="MAVLink"]; sitl -> gz [dir=both, label="lock-step"];
}
