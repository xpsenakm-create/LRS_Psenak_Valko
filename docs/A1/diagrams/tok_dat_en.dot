digraph G {
  rankdir=TB; bgcolor=white; pad=0.25; nodesep=0.3; ranksep=0.35; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor="#eef4fc", color="#2a78d6", penwidth=1.3, fontname="DejaVu Sans", fontsize=12, margin="0.14,0.07"];
  edge [color="#52514e", penwidth=1.2, arrowsize=0.8, fontname="DejaVu Sans", fontsize=10, fontcolor="#3f3f3f"];
  subgraph cluster_a11 { label="A1.1  map_planner_node (once at start-up + on request)"; fontname="DejaVu Sans"; fontsize=13; style=rounded; color="#2a78d6";
    pcd [label="map.pcd\n620 311 points", shape=note, fillcolor="#f4f4f2", color="#888888"];
    yaml [label="planner.yaml\nvoxel 0.15 m, safety 0.45 m,\nrack_boxes", shape=note, fillcolor="#f4f4f2", color="#888888"];
    vg [label="PCL VoxelGrid 0.15 m\n62 689 points"];
    occ [label="hash set of\noccupied voxels"];
    rack [label="racks filled\nas solid boxes"];
    infl [label="inflation\nsphere r = 0.45 m"];
    dense [label="dense array\n128 × 102 × 46"];
    astar [label="A* (26-connected,\noctile heuristic)"];
    simp [label="line-of-sight shortcut\n+ collision check"];
    pcd -> vg -> occ -> rack -> infl -> dense -> astar -> simp; yaml -> rack; yaml -> infl;
  }
  subgraph cluster_a12 { label="A1.2  mission_executor_node (20 Hz)"; fontname="DejaVu Sans"; fontsize=13; style=rounded; color="#2a78d6";
    csv [label="mission.csv\nx,y,z,precision,task", shape=note, fillcolor="#f4f4f2", color="#888888"];
    sm [label="state machine\n(goal = mission waypoint)"];
    car [label="carrot along segments\n1 m/s, ≤ 1 m ahead\nyaw = segment direction"];
    m2l [label="map → MAVROS local\n(90° rotation)"];
    csv -> sm -> car -> m2l;
  }
  subgraph cluster_a13 { label="A1.3  outdoor_mission_node (30 Hz)"; fontname="DejaVu Sans"; fontsize=13; style=rounded; color="#2a78d6";
    gps [label="GPS fixes (≥ 8 sats, ≤ 2 m)\n3 s mean → origin", shape=note, fillcolor="#f4f4f2", color="#888888"];
    ltp [label="lat/lon ↔ ENU\n(WGS-84 tangent plane)"];
    geo [label="POI, square corners,\nfigure-8 around POI"];
    mot [label="carrot (square) / θ = ωt (figure-8)\nyaw to POI / tangent"];
    gps -> ltp -> geo -> mot;
  }
  sp [label="setpoints\n→ MAVROS → ArduCopter SITL", shape=box3d, fillcolor="#f4f4f2", color="#888888"];
  log [label="CSV logs + rosbag\n→ plots, clearance check", shape=cylinder, fillcolor="#f4f4f2", color="#888888"];
  sm -> astar [label="plan_request"]; simp -> car [label="planned_path"];
  m2l -> sp; mot -> sp; sp -> log [style=dashed];
}
