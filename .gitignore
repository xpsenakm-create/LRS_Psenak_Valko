# ROS 2 / colcon build artifacts -- nikdy necommitovať
build/
install/
log/

# Editor / IDE
.vscode/
.idea/
*.swp

# Kompilátor
*.o
*.obj
*.so
*.a

# OS
.DS_Store
Thumbs.db

# Rosbagy -- vieš dokopy pridať konkrétny priečinok s finálnym bagom výnimkou,
# ale surové nahrávky sú väčšinou príliš veľké na git
*.bag
*.mcap
rosbag2_*/

# Python cache, ak sa niekde objaví
__pycache__/
*.pyc
*.pyo
*.pyd
map_voxels_with_racks_inflated.pcd/

# Výstupy každého behu misie v koreni repa (prepisujú sa pri každom lete).
# Finálny, odovzdávaný beh je archivovaný v results/ -- tam sa NEignoruje nič.
/outdoor_mission_log.csv
/outdoor_mission_plot.png
/plot_*.png
/outdoor_flight_bag_*/
!results/**/*.mcap

# A2: do gitu ide iba to, na čo odkazuje dokumentácia, a textové súhrny všetkých behov.
# Bagy, logy, videá a ostatné grafy ostávajú lokálne; znova ich vytvorí ./run_assignment2.sh --all
results/A2/**/bag/
results/A2/**/logs/
results/A2/**/*.mp4
results/A2/**/*.png
results/A2/flight_*/characterization.txt
!results/A2/flight_seed42/a2_trajectory.png
!results/A2/flight_seed42/a2_errors.png
!results/A2/flight_seed42/a2_filter.png
!results/A2/characterization/seed42/a2_sensors_seed42.png
