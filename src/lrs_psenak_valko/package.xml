<?xml version="1.0"?>
<package format="3">
  <name>lrs_psenak_valko</name>
  <version>0.0.1</version>
  <description>LRS Assignments 1 and 2 — autonomous indoor/outdoor missions and eight-state EKF localisation (GPS + VO + gyro)</description>
  <maintainer email="mpsenak0@gmail.com">Mark Psenak</maintainer>
  <author email="valko.samos@gmail.com">Valko</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>std_srvs</depend>
  <depend>libpcl-all-dev</depend>
  <depend>nav_msgs</depend>
  <depend>eigen</depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
